# Sanity CMS — copy this file to `.env.local` and fill in your values.
#
# 1. Create a free Sanity project at https://www.sanity.io/manage
# 2. Copy your Project ID below
# 3. Use the default dataset name "production" (unless you created another one)
# 4. Add your team members in sanity.io/manage → Members
# 5. Restart `npm run dev` after editing this file

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-05-01
